# LLM credentials for the job-application agent.
# Copy this to .env and fill in your key:   cp .env.example .env
# .env is gitignored — never commit real keys.
#
# The client is OpenAI-compatible (main.py -> openai.OpenAI).
# apply.sh sources this file; main.py also reads these vars directly.

# REQUIRED: your API key (OpenAI, or any compatible provider).
LLM_API_KEY=

# OPTIONAL: only set if you are NOT using api.openai.com
#   e.g. Azure/Foundry:  https://<resource>.openai.azure.com/openai/v1
#   e.g. OpenRouter:      https://openrouter.ai/api/v1
#   e.g. Gemini (OpenAI-compat):  https://generativelanguage.googleapis.com/v1beta/openai/
#LLM_BASE_URL=

# OPTIONAL: model name. Code default is "gemini-3.7-flash" (see main.py).
# Set this to a model your key can actually call, e.g.:
#LLM_MODEL=claude-haiku-4-5

# OPTIONAL: thinking budget for reasoning-capable models (Gemini 3.x, o-series).
# "" | none | minimal | low | medium | high. Code default is "low" — enough for
# form-field mapping and resume tailoring without burning thinking tokens.
# Set to "" to omit the param entirely for models that reject it.
#LLM_REASONING_EFFORT=low
